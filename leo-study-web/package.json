{
  "name": "leo-study-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "stripe:webhook": "node backend/stripe-webhook.mjs",
    "owner:bootstrap": "node backend/bootstrap-owner.mjs",
    "content:sync": "node backend/sync-content-items.mjs",
    "content:pull": "node backend/pull-content-items.mjs",
