# Use only for the separate Coolify application tracking the exact dev branch.
# No runtime secret is a build argument. Do not enable Coolify's automatic
# injection of runtime environment variables into build arguments.
FROM node:22.22.0-alpine@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm test && npm run lint
ARG VITE_SUPABASE_ANON_KEY
ARG SOURCE_COMMIT
RUN node scripts/development/build-github.mjs

FROM node:22.22.0-alpine@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS runtime
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node backend/coolify-server.mjs backend/stripe-tier-service.mjs backend/stripe-membership-service.mjs backend/membership-analytics.mjs backend/class-request-service.mjs backend/class-request-email-service.mjs backend/live-integrations.mjs ./backend/
COPY --from=build --chown=node:node /app/backend/data/membership-content.json ./backend/data/membership-content.json
COPY --chown=node:node scripts/development/deployment-config.mjs scripts/development/start-github.mjs ./scripts/development/
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8789
USER node
EXPOSE 8789
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:8789/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "scripts/development/start-github.mjs"]
