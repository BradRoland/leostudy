VITE_SUPABASE_URL=https://supabase.180.academy
# Isolated preview only: set BOTH flags true to disable checkout, live game worker,
# telemetry, Stripe/Discord handlers, and the Coolify deployment webhook proxy.
# Supabase and class approval mail keep using their explicitly configured test services.
VITE_DISABLE_LIVE_INTEGRATIONS=false
DISABLE_LIVE_INTEGRATIONS=false
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_ANON_KEY
VITE_CONTENT_SOURCE=local
VITE_AUTH_REDIRECT_BASE_URL=https://180.academy
VITE_INVITE_BASE_URL=https://join.180.academy
VITE_ROPE_BLASTER_WORKER_URL=https://leo-rope-blaster.brad-e22.workers.dev
VITE_OWNER_EMAIL=owner@example.com
VITE_SUPABASE_AVATAR_BUCKET=avatars
VITE_ENABLE_VERCEL_TELEMETRY=false
VITE_STRIPE_LINK_TIER2=https://buy.stripe.com/YOUR_TIER2_LINK
VITE_STRIPE_LINK_TIER5=https://buy.stripe.com/YOUR_TIER5_LINK
VITE_STRIPE_LINK_TIER10=https://buy.stripe.com/YOUR_TIER10_LINK
SUPABASE_URL=https://supabase.180.academy
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=sk_live_or_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_PORT=8788
STRIPE_TEST_TOKEN=YOUR_LOCAL_TEST_TOKEN
DISCORD_CLASS_REQUEST_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK
# Class approvals: disabled until the isolated test mail transport is verified.
CLASS_REQUEST_EMAIL_ENABLED=false
CLASS_REQUEST_EMAIL_FROM=180 Academy <noreply@example.com>
CLASS_REQUEST_OWNER_EMAIL=owner@example.com
CLASS_REQUEST_APP_URL=http://localhost:5174
# Redirect every workflow email to a mail sink while testing.
CLASS_REQUEST_EMAIL_TEST_RECIPIENT=
CLASS_REQUEST_SMTP_HOST=
CLASS_REQUEST_SMTP_PORT=587
CLASS_REQUEST_SMTP_SECURE=false
CLASS_REQUEST_SMTP_REQUIRE_TLS=true
CLASS_REQUEST_SMTP_USER=
CLASS_REQUEST_SMTP_PASSWORD=
# Optional HTTPS provider when SMTP is not configured.
RESEND_API_KEY=
STRIPE_PRICE_ID_TIER2=price_REPLACE_TIER2
STRIPE_PRICE_ID_TIER5=price_REPLACE_TIER5
STRIPE_PRICE_ID_TIER10=price_REPLACE_TIER10
STRIPE_PAYMENT_LINK_ID_TIER2=plink_REPLACE_TIER2
STRIPE_PAYMENT_LINK_ID_TIER5=plink_REPLACE_TIER5
STRIPE_PAYMENT_LINK_ID_TIER10=plink_REPLACE_TIER10

# Monthly memberships: separate recurring prices and portal configuration.
# Keep the legacy price/link mappings above for original one-time purchases.
STRIPE_MONTHLY_PRICE_TIER5=price_MONTHLY_PLUS
STRIPE_MONTHLY_PRICE_TIER10=price_MONTHLY_PRO
STRIPE_PORTAL_CONFIGURATION=bpc_MONTHLY_MEMBERSHIPS
ACADEMY_PUBLIC_URL=https://180.academy
