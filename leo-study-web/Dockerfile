FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY
ARG VITE_AUTH_REDIRECT_BASE_URL
ARG VITE_INVITE_BASE_URL
ARG VITE_DISABLE_LIVE_INTEGRATIONS
ARG VITE_ROPE_BLASTER_WORKER_URL
ARG VITE_CONTENT_SOURCE
ARG VITE_STRIPE_LINK_TIER2
ARG VITE_STRIPE_LINK_TIER5
ARG VITE_STRIPE_LINK_TIER10

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=$VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY
ENV VITE_AUTH_REDIRECT_BASE_URL=$VITE_AUTH_REDIRECT_BASE_URL
ENV VITE_INVITE_BASE_URL=$VITE_INVITE_BASE_URL
ENV VITE_DISABLE_LIVE_INTEGRATIONS=$VITE_DISABLE_LIVE_INTEGRATIONS
ENV VITE_ROPE_BLASTER_WORKER_URL=$VITE_ROPE_BLASTER_WORKER_URL
ENV VITE_CONTENT_SOURCE=$VITE_CONTENT_SOURCE
ENV VITE_STRIPE_LINK_TIER2=$VITE_STRIPE_LINK_TIER2
ENV VITE_STRIPE_LINK_TIER5=$VITE_STRIPE_LINK_TIER5
ENV VITE_STRIPE_LINK_TIER10=$VITE_STRIPE_LINK_TIER10

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build
RUN npm prune --omit=dev

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=80

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/backend ./backend
COPY --from=build /app/dist ./dist

EXPOSE 80

CMD ["node", "backend/coolify-server.mjs"]
